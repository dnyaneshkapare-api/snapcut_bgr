# Browser-safe integration values
VITE_N8N_PROCESSING_WEBHOOK_URL=https://your-n8n-host/webhook/snapcut-process
VITE_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Server-only values belong in the deployment secret manager, never in browser code.
N8N_WEBHOOK_SECRET=replace-in-secret-manager
CLOUDINARY_API_KEY=replace-in-secret-manager
CLOUDINARY_API_SECRET=replace-in-secret-manager
REMOVE_BG_API_KEY=replace-in-secret-manager
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-manager
RAZORPAY_KEY_SECRET=replace-in-secret-manager
